{
  "kind": "proposed-contract-example",
  "name": "string-minutes",
  "precondition": {
    "seed_tasks": []
  },
  "request": {
    "method": "POST",
    "target": "/tasks",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "title": "Wrong minutes",
      "minutes": "15"
    }
  },
  "response": {
    "status": 422,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "detail": [
        {
          "type": "int_type",
          "loc": [
            "body",
            "minutes"
          ],
          "msg": "Input should be a valid integer",
          "input": "15"
        }
      ]
    }
  }
}
