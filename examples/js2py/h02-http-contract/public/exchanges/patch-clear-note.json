{
  "kind": "proposed-contract-example",
  "name": "patch-clear-note",
  "precondition": {
    "seed_tasks": [
      {
        "title": "  Read HTTP  ",
        "minutes": 25,
        "done": false,
        "note": "keep me"
      }
    ]
  },
  "request": {
    "method": "PATCH",
    "target": "/tasks/1",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "note": null
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "id": 1,
      "title": "  Read HTTP  ",
      "minutes": 25,
      "done": false,
      "note": null
    }
  }
}
