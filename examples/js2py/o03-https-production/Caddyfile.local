# UNEXECUTED: Caddy is not installed in the verification environment.
# Same-host alternative to tls_lab.py; never run both on the same port.
# TLS_CERT/TLS_KEY must refer to an independently owned temporary certificate pair.
{
    admin off
    auto_https off
}
https://lab.test:8443 {
    bind 127.0.0.1
    tls {$TLS_CERT} {$TLS_KEY}
    reverse_proxy 127.0.0.1:8034 {
        header_up -Forwarded
    }
}
