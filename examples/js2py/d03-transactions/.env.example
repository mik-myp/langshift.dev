# Documentation only: this file is NOT automatically loaded.
# Point PG_BIN to a directory containing initdb, pg_ctl, psql and postgres.
PG_BIN=/opt/homebrew/bin
# The lab deliberately ignores DATABASE_URL and PGHOST/PGPORT/PGUSER.
# Use: uv run --locked python labctl.py dsn
# It produces an owned, local Unix-socket DSN with no password.
