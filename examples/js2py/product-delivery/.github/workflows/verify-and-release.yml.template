name: product-verification
on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    container: python:3.13.15-slim-bookworm
    services:
      migration_db:
        image: postgres:18.6
        env:
          POSTGRES_DB: product_migration
          POSTGRES_USER: product_migration
          # Disposable CI credential; never reuse it as a production role.
          POSTGRES_PASSWORD: migration-ci-only
        options: >-
          --health-cmd "pg_isready -U product_migration -d product_migration"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
      test_db:
        image: postgres:18.6
        env:
          POSTGRES_DB: product_test
          POSTGRES_USER: product_test
          # Disposable CI credential; never reuse it as a production role.
          POSTGRES_PASSWORD: test-ci-only
        options: >-
          --health-cmd "pg_isready -U product_test -d product_test"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    env:
      MIGRATION_DATABASE_URL: postgresql+psycopg://product_migration:migration-ci-only@migration_db:5432/product_migration
      TEST_DATABASE_URL: postgresql+psycopg://product_test:test-ci-only@test_db:5432/product_test
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2; review before upgrading
        with:
          persist-credentials: false
      - name: Install the selected toolchain
        run: python -m pip install --no-cache-dir --index-url https://pypi.org/simple uv==0.12.13
      - name: Reconstruct the locked product environment
        run: uv sync --locked --no-managed-python --python /usr/local/bin/python
      - name: Upgrade and compare the ephemeral CI database
        run: |
          DATABASE_URL="$MIGRATION_DATABASE_URL" uv run --locked python -m alembic upgrade head
          DATABASE_URL="$MIGRATION_DATABASE_URL" uv run --locked python -m alembic check
      - name: Run the learner product's isolated regression suite
        run: DATABASE_URL="$TEST_DATABASE_URL" TEST_DATABASE_URL="$TEST_DATABASE_URL" uv run --locked python -m pytest -q
  release:
    if: github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main'
    needs: verify
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    environment: production
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          persist-credentials: false
      - name: Require the implemented deployment adapter
        shell: bash
        run: |
          set -euo pipefail
          if [ ! -x ops/deploy-approved.sh ]; then
            echo "Implement and review ops/deploy-approved.sh; release is incomplete" >&2
            exit 1
          fi
          ops/deploy-approved.sh "$GITHUB_SHA"
